# Ignore test-related files
/coverage.data
/coverage/
.wwebjs_auth/
# Certificados TLS locais (contem chave privada)
certs/

# Artefatos da maquina que hospeda a instalacao, nao do projeto: o executavel
# do NSSM (que registra backend e frontend como servicos do Windows) e a
# saida dos servicos.
/bin/
/logs/

# Painel de operacao: a senha (hash scrypt) e o registro de quem ligou e
# desligou o que sao desta instalacao, nao do codigo.
/painel/config.json
/painel/auditoria.log
/painel/energia.json

# Endereco publico do tunel provisorio: e sorteado a cada execucao do
# cloudflared, entao pertence a execucao, nao ao projeto.
/frontend/endereco-publico.json

# Reserva do deploy automatico e backups pontuais: sao desta maquina, nao do projeto.
/.reserva-deploy/
/backend/.backup-seguranca/
/backend/.env.antes-da-rotacao
/backend/.senha-nova-temporaria.txt
