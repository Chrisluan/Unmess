<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Upu.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Upu.Server</AssemblyName>
    <UserSecretsId>unmess-production-updater</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Única dependência do UPU. Faz o mesmo executável servir tanto rodando
      como Serviço do Windows (produção) quanto no console (desenvolvimento):
      UseWindowsService() se anula sozinho quando não há um controlador de
      serviços do outro lado.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Upu.Core\Upu.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- O painel e o widget de aviso viajam junto do executável publicado. -->
    <Content Include="publico\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="recursos\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
