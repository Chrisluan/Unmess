# DESENVOLVIMENTO - Variáveis Locais
NODE_ENV=development

# MYSQL
MYSQL_ENGINE=mysql
MYSQL_VERSION=8.0
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=whaticket
MYSQL_PORT=3306
MYSQL_HOST=localhost
TZ=America/Sao_Paulo

# BACKEND
BACKEND_HOST=localhost
BACKEND_PORT=3000
BACKEND_SERVER_NAME=localhost
BACKEND_URL=http://localhost:3000
BACKEND_CORS_ORIGIN=http://localhost:3001
PROXY_PORT=3000
JWT_SECRET=dev_secret_key_change_this_is_unsafe
JWT_REFRESH_SECRET=dev_refresh_secret_change_this_is_unsafe
LOG_LEVEL=debug

# FRONTEND
FRONTEND_HOST=localhost
FRONTEND_PORT=3001
FRONTEND_SSL_PORT=443
FRONTEND_SERVER_NAME=localhost
FRONTEND_URL=http://localhost:3001
REACT_APP_BACKEND_URL=http://localhost:3000

# SSL/HTTPS
SSL_CERT_PATH=
SSL_KEY_PATH=

# BROWSERLESS
MAX_CONCURRENT_SESSIONS=5
BROWSERLESS_HOST=localhost
BROWSERLESS_PORT=3000

# PHPMYADMIN
PMA_PORT=8081
PMA_HOST=localhost

# API RATE LIMITING
API_RATE_LIMIT=1000
API_RATE_LIMIT_WINDOW=15
