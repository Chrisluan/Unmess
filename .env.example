# Ambiente de desenvolvimento local do Unmess.
# Copiado para .env por "scripts/dev.ps1 setup", que troca os valores "gerar" por segredos aleatórios.
# O .env fica fora do Git. Nunca coloque aqui dados ou segredos de produção.

APP_ENV=development
TZ=America/Fortaleza

# Banco MySQL do container de dev (deploy/compose.dev.yaml), exposto só em 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=unmess
DB_USER=unmess
DB_PASS=gerar
DB_ROOT_PASS=gerar

# Redis do container de dev
REDIS_PORT=6379

# Backend Node (porta que o frontend espera) e segredos do JWT compartilhados com o backend .NET
BACKEND_PORT=8080
JWT_SECRET=gerar
JWT_REFRESH_SECRET=gerar

# Provedor de WhatsApp do backend Node: whaileys (atual) ou wwebjs
WHATSAPP_PROVIDER=whaileys

# Backend .NET
DOTNET_API_PORT=5240

# Gateway WhatsApp: fake simula conexões e mensagens; baileys conecta de verdade (use só número de teste)
GATEWAY_PORT=8090
GATEWAY_MODE=fake
GATEWAY_API_TOKEN=gerar
GATEWAY_WEBHOOK_SECRET=gerar
GATEWAY_ENCRYPTION_KEY=gerar
GATEWAY_SEND_INTERVAL_MS=1500

# Frontend (Vite)
FRONTEND_PORT=3001
