{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Deployer": {
    "DatabasePath": "deployer.db",
    "WebhookSecret": "",
    "ApiToken": "",
    "PreviewUrlTemplate": "https://{release}.example.com",
    "ProductionUrl": "https://app.example.com",
    "MaxActivePreviews": 3,
    "MajorVersion": 1,
    "KeptProductionImages": 5,
    "SignatureTolerance": "00:05:00",
    "HealthCheckWindow": "00:01:00",
    "HealthCheckInterval": "00:00:05",
    "RequiredHealthyChecks": 3,
    "ReconciliationInterval": "00:05:00"
  }
}
